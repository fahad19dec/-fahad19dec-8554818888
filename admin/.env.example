# Copy to .env.local (gitignored) and fill in.

# ---- Sign-in (Clerk) -------------------------------------------------------------
# The same Clerk application as the guest app (axe-stays/.env.local), so one
# account works in both. Only accounts with the admin role get in.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Local development without Clerk: sign in with any email, no password.
# Ignored in production builds. Leave empty to use Clerk.
# AUTH_MODE=dev

# Emails that become admins on first sign-in, comma separated.
ADMIN_EMAILS=

# ---- Data -------------------------------------------------------------------------
# The folder holding the shared SQLite database (axe-stays.sqlite) and uploaded
# photos. Must be the same folder the guest app uses.
DATA_DIR=../axe-stays/data

# Where the guest app runs, for "View in app" links. Optional.
GUEST_APP_URL=http://localhost:8081
