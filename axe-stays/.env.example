# Copy to .env.local (gitignored) and fill in.

# ---- Sign-in (Clerk) -------------------------------------------------------------
# From the Clerk dashboard → API keys. Use the same Clerk application for the
# admin dashboard (admin/.env.local), so one account works in both.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Local development without Clerk: "dev" lets you sign in with any email,
# no password. Ignored when NODE_ENV=production. Leave empty to use Clerk.
# AUTH_MODE=dev
# EXPO_PUBLIC_AUTH_MODE=dev

# Emails that become admins on first sign-in, comma separated.
ADMIN_EMAILS=

# ---- Data -------------------------------------------------------------------------
# Where the shared SQLite database (axe-stays.sqlite) and uploaded photos live.
# Default: ./data. The admin dashboard must point at the same folder.
# DATA_DIR=

# Sample guests, bookings and reports are added to a new database outside
# production. Set to 0 to start empty.
# SEED_SAMPLE_ACTIVITY=0

# The API server's origin for native release builds, e.g. https://stays.example.com.
# In development, the app talks to the Expo dev server and this isn't needed.
# EXPO_PUBLIC_API_URL=
