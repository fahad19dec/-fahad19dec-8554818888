# Copy to .env.local (gitignored) and fill in.

# Password for the /admin screens (8+ characters). Server only: never EXPO_PUBLIC_.
ADMIN_PASSWORD=

# Optional. Where db.json and uploaded photos live (default: ./data).
# DATA_DIR=

# Optional. The API server's origin for native release builds, e.g. https://stays.example.com.
# In development, the app talks to the Expo dev server and this isn't needed.
# EXPO_PUBLIC_API_URL=
